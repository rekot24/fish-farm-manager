# Normalize line endings to LF in the repo, auto-convert on checkout
* text=auto eol=lf

# Force these to always be LF
*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jar binary
*.zip binary
