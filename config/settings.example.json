  "debug": {
    "enabled": false,
    "log_state_changes": true,
    "log_detections": false,
    "log_actions": false,
    "log_health": false,
    "log_config_reads": false,
    "screenshot_on_event": false,
    "save_failed_captures": true,
    "screenshot_dir": "debug_shots"
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "log_to_file": true,
    "log_to_console": true,
    "max_file_size_mb": 10,
    "backup_count": 3
