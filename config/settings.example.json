{
  "adb_path": "C:/path/to/platform-tools/adb.exe",
  "scan_interval_ms": 800,
  "template_confidence_default": 0.82,
  "private_server_link": "",
  "capture_backend_default": "scrcpy",
  "development_mode": false,
  "health": {
    "battery_min_percent": 20,
    "battery_resume_percent": 80,
    "temp_throttle_celsius": 45.0,
    "temp_pause_celsius": 52.0,
    "temp_resume_celsius": 40.0,
    "adb_reconnect_interval_s": 10,
    "crash_detect_after_s": 60.0,
    "crash_recovery_settle_s": 3.0,
    "battery_sleep_settle_s": 1.0,
    "battery_sleep_poll_s": 60.0,
    "wake_settle_s": 10.0,
    "temp_pause_poll_s": 30.0,
    "thermal_throttle_multiplier": 2.0
  },
  "adb": {
    "quick_timeout_s": 5.0,
    "default_timeout_s": 10.0,
    "launch_timeout_s": 15.0,
